# Copy to .env.local and fill in. Never commit .env.local.

# --- Browser-safe (exposed to the frontend) ---
VITE_SUPABASE_URL=https://znjiyhfedmnweoycljys.supabase.co
# Supabase dashboard → Project Settings → API Keys → publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Maps Demo Key — restrict to your Vercel domain + localhost
VITE_GOOGLE_MAPS_KEY=

# --- Server-only (Vercel /api/* functions; set in Vercel env vars) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# https://explore.openaq.org/register
OPENAQ_API_KEY=
# Fallback routing only — https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
